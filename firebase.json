{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "CREDITS.md",
      "LICENSE",
      "firestore.rules",
      "tools/**",
      "cookbook/**",
      "SETUP.md",
      "bundle-and-bite.zip",
      "*.zip"
    ],
    "headers": [
      {
        "source": "photos/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}